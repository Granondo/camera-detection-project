                    "has_detection": {
                        "type": "boolean"
                    },
                    "image_url": {
                        "type": "string"
                    },
                    "thumbnail_url": {
                        "type": "string"
                    }
                }
            },
            "api.RecordingResponse": {
                "type": "object",
                "properties": {
                    "download_url": {
                        "type": "string"
                    },
                    "file_exists": {
                        "type": "boolean"
                    },
                    "recording": {
                        "$ref": "#/components/schemas/storage.Recording"
