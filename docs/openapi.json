                        "type": "integer"
                    },
                    "detections": {
                        "type": "integer"
                    },
                    "events": {
                        "type": "integer"
                    },
                    "frames": {
                        "type": "integer"
                    },
                    "recordings": {
                        "type": "integer"
                    },
                    "storage_usage_bytes": {
                        "type": "integer"
                    }
                }
            },
            "api.TopObjectsResponse": {
