                                }
                            }
                        }
                    }
                }
            }
        },
        "/recordings/{id}": {
            "get": {
                "description": "Получить информацию о конкретной записи",
                "tags": [
                    "recordings"
                ],
                "summary": "Get recording by ID",
                "parameters": [
                    {
                        "description": "Recording ID",
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/api.APIResponse"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/api.RecordingResponse"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.APIResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/stats": {
            "get": {
                "description": "Получить статистику базы данных",
                "tags": [
