{
    "openapi": "3.0.0",
    "info": {
        "description": "API для системы видеонаблюдения с YOLO детекцией",
        "title": "Camera Surveillance API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/analytics/detections/hourly": {
            "get": {
                "description": "Получить детекции по часам",
                "tags": [
                    "analytics"
                ],
                "summary": "Get detections by hour",
                "parameters": [
                    {
                        "description": "Hours to look back",
                        "name": "hours",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 168,
                            "default": 24
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/api.APIResponse"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/api.DetectionsHourlyResponse"
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.APIResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/analytics/summary": {
            "get": {
                "description": "Получить сводку аналитики из ClickHouse",
                "tags": [
                    "analytics"
                ],
                "summary": "Get analytics summary",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/api.APIResponse"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/api.AnalyticsSummaryResponse"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.APIResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/analytics/top-objects": {
            "get": {
                "description": "Получить топ обнаруженных объектов",
                "tags": [
                    "analytics"
                ],
                "summary": "Get top detected objects",
                "parameters": [
                    {
                        "description": "Days to look back",
                        "name": "days",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 90,
                            "default": 7
                        }
                    },
                    {
                        "description": "Limit",
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 50,
                            "default": 10
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/api.APIResponse"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/api.TopObjectsResponse"
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.APIResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/cache/clear": {
            "post": {
                "description": "Очистить весь кэш Redis",
                "tags": [
                    "system"
                ],
                "summary": "Clear cache",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.APIResponse"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/api.APIResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/camera": {
            "get": {
                "description": "Получить информацию о камере",
                "tags": [
                    "camera"
                ],
                "summary": "Get camera information",
