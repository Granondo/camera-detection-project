                        }
                    },
                    "total_detections": {
                        "type": "integer"
                    }
                }
            },
            "api.DetectionsHourlyResponse": {
                "type": "object",
                "properties": {
                    "avg_confidence": {
                        "type": "number"
                    },
                    "hour": {
                        "type": "string"
                    },
                    "max_confidence": {
                        "type": "number"
                    },
                    "min_confidence": {
                        "type": "number"
                    },
                    "object_class": {
                        "type": "string"
                    },
                    "total_detections": {
                        "type": "integer"
                    }
                }
            },
            "api.FrameResponse": {
                "type": "object",
                "properties": {
                    "file_exists": {
                        "type": "boolean"
                    },
