                    "updated_at": {
                        "type": "string"
                    },
                    "username": {
                        "type": "string"
                    }
                }
            },
            "storage.Event": {
                "type": "object",
                "properties": {
                    "camera_id": {
                        "type": "integer"
                    },
                    "created_at": {
                        "type": "string"
                    },
                    "event_type": {
                        "description": "motion, person_detected, system_error, etc",
                        "type": "string"
                    },
                    "id": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "metadata": {
                        "description": "JSON with additional data",
                        "type": "string"
                    },
                    "notified": {
                        "type": "boolean"
                    },
                    "resolved": {
                        "type": "boolean"
                    },
                    "resolved_at": {
                        "type": "string"
