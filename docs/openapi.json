    },
    "servers": [
        {
            "url": "//localhost:8080/api"
        }
    ],
    "components": {
        "schemas": {
            "api.APIResponse": {
                "type": "object",
                "properties": {
                    "cached": {
                        "type": "boolean"
                    },
                    "data": {},
                    "error": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "success": {
                        "type": "boolean"
                    }
                }
            },
            "api.AnalyticsSummaryResponse": {
                "type": "object",
                "properties": {
                    "clickhouse_available": {
                        "type": "boolean"
                    },
                    "detections_by_hour": {
