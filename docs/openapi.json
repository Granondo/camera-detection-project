                    },
                    "timestamp": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    }
                }
            },
            "storage.Frame": {
                "type": "object",
                "properties": {
                    "camera_id": {
                        "type": "integer"
                    },
                    "created_at": {
                        "type": "string"
                    },
                    "file_path": {
                        "type": "string"
                    },
                    "file_size": {
                        "type": "integer"
                    },
                    "has_detection": {
                        "type": "boolean"
                    },
                    "height": {
                        "type": "integer"
                    },
                    "id": {
                        "type": "integer"
                    },
                    "processed": {
                        "type": "boolean"
                    },
                    "recording_id": {
                        "description": "Can be null for standalone frames",
                        "type": "integer"
                    },
                    "thumbnail_path": {
                        "type": "string"
                    },
                    "timestamp": {
                        "type": "string"
                    },
                    "width": {
                        "type": "integer"
                    }
                }
            },
            "storage.Recording": {
                "type": "object",
                "properties": {
                    "archived_at": {
                        "type": "string"
                    },
                    "camera_id": {
                        "type": "integer"
                    },
                    "codec": {
                        "description": "h264, h265, etc",
                        "type": "string"
                    },
                    "created_at": {
                        "type": "string"
                    },
                    "duration": {
                        "description": "seconds",
                        "type": "integer"
                    },
                    "end_time": {
                        "type": "string"
                    },
                    "file_path": {
                        "type": "string"
                    },
                    "file_size": {
                        "type": "integer"
                    },
                    "id": {
                        "type": "integer"
                    },
                    "quality": {
                        "description": "1080p, 720p, etc",
                        "type": "string"
                    },
                    "start_time": {
                        "type": "string"
                    },
                    "status": {
